#!/bin/sh
# Hook runs from the git repo root (UPLIVE-Test); the Gradle project is in myproject/
cd "$(dirname "$0")/.." || exit 1

echo "Running ktlintFormat before commit..."
./gradlew ktlintFormat
STATUS=$?
if [ $STATUS -ne 0 ]; then
  echo "ktlintFormat failed. Please fix the issues and re-commit."
  exit 1
fi
# Re-stage formatted files
git add -u
echo "ktlintFormat passed."
exit 0
